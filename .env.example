# --- Docker Compose (host-side path substitution; not passed into the container) ---
# Real host paths to your media library. Required for `docker compose up` --
# without these, the placeholder paths in docker-compose.yml get bind-mounted
# instead (harmless, just empty). In Arcane, set these in the project's .env
# panel rather than editing docker-compose.yml directly.
MOVIES_HOST_PATH=/path/on/host/to/movies
TV_HOST_PATH=/path/on/host/to/tv

# --- App config (passed into the container / read by a bare python run) ---
TMDB_API_KEY=
MEDIA_MANAGER_CONFIG=./config.yaml
